<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Amine — Portfolio</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#070e1a;
  --bg2:#0a1525;
  --surface:#0f1e30;
  --surface2:#13253c;
  --cyan:#00d4c8;
  --cyan2:#00a8b8;
  --cyan-dim:rgba(0,212,200,0.12);
  --text:#e8f4f8;
  --muted:#6b8fa8;
  --muted2:#4a6880;
  --border:rgba(0,212,200,0.14);
  --border2:rgba(0,212,200,0.28);
}
html{scroll-behavior:smooth;height:100%}
body{
  background:var(--bg);
  color:var(--text);
  font-family:'Inter',sans-serif;
  min-height:100vh;
  overflow-x:hidden;
}

/* ===== BACKGROUND ===== */
.bg-layer{
  position:fixed;inset:0;pointer-events:none;z-index:0;
  background:
    radial-gradient(ellipse 55% 55% at 75% 48%, rgba(0,168,184,0.07) 0%, transparent 70%),
    radial-gradient(ellipse 35% 45% at 8% 75%, rgba(0,80,100,0.09) 0%, transparent 65%);
}
.bg-grid{
  position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:
    linear-gradient(rgba(0,212,200,0.03) 1px,transparent 1px),
    linear-gradient(90deg,rgba(0,212,200,0.03) 1px,transparent 1px);
  background-size:60px 60px;
}

/* ===== NAV ===== */
nav{
  position:fixed;top:0;left:0;right:0;
  display:flex;align-items:center;justify-content:space-between;
  padding:1rem 4rem;
  background:rgba(7,14,26,0.85);
  backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);
  z-index:200;
}
.logo{
  font-family:'Syne',sans-serif;
  font-size:1.45rem;font-weight:800;
  color:var(--text);letter-spacing:-0.5px;
  cursor:pointer;
}
.logo span{
  display:inline-block;
  background:var(--cyan);
  color:#070e1a;
  padding:0 6px 1px;
  border-radius:4px;
  margin-right:1px;
}
.nav-links{display:flex;gap:2.5rem;list-style:none}
.nav-links a{
  color:var(--muted);
  text-decoration:none;
  font-size:.88rem;
  font-weight:400;
  letter-spacing:.4px;
  transition:color .2s;
  cursor:pointer;
  position:relative;
  padding-bottom:2px;
}
.nav-links a::after{
  content:'';position:absolute;bottom:0;left:0;right:0;
  height:1px;background:var(--cyan);
  transform:scaleX(0);transform-origin:left;
  transition:transform .25s;
}
.nav-links a:hover,.nav-links a.active{color:var(--cyan)}
.nav-links a.active::after,.nav-links a:hover::after{transform:scaleX(1)}

/* ===== PAGE SYSTEM ===== */
.page{display:none;min-height:100vh;padding-top:74px;position:relative;z-index:1}
.page.active{display:block}

/* ===== ANIMATIONS ===== */
@keyframes dropIn{
  0%{transform:translateY(-340px) rotate(-4deg);opacity:0}
  55%{transform:translateY(18px) rotate(1deg);opacity:1}
  72%{transform:translateY(-10px) rotate(-0.5deg)}
  85%{transform:translateY(6px) rotate(0.3deg)}
  100%{transform:translateY(0) rotate(0deg);opacity:1}
}
@keyframes fadeUp{
  from{opacity:0;transform:translateY(22px)}
  to{opacity:1;transform:translateY(0)}
}
@keyframes fadeIn{
  from{opacity:0}to{opacity:1}
}
@keyframes slideLeft{
  from{opacity:0;transform:translateX(30px)}
  to{opacity:1;transform:translateX(0)}
}
@keyframes pulse-ring{
  0%{transform:scale(.95);box-shadow:0 0 0 0 rgba(0,212,200,.35)}
  70%{transform:scale(1);box-shadow:0 0 0 10px rgba(0,212,200,0)}
  100%{transform:scale(.95);box-shadow:0 0 0 0 rgba(0,212,200,0)}
}
@keyframes float{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-10px)}
}

/* ===== HOME PAGE ===== */
#page-home{
  display:flex;align-items:center;justify-content:center;
  min-height:100vh;
  padding:74px 4rem 3rem;
}
.hero-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  width:100%;max-width:1100px;
  gap:3rem;
}
.hero-left{max-width:520px}

.badge{
  display:inline-flex;align-items:center;gap:.5rem;
  background:rgba(255,255,255,0.05);
  border:1px solid var(--border);
  border-radius:99px;
  padding:.38rem 1.1rem;
  font-size:.8rem;color:var(--muted);
  margin-bottom:1.8rem;
  animation:fadeUp .6s ease both;
}
.hero-h1{
  font-family:'Syne',sans-serif;
  font-size:clamp(2.6rem,4.5vw,3.4rem);
  font-weight:800;line-height:1.08;
  margin-bottom:1rem;
  animation:fadeUp .7s .1s ease both;
}
.hero-h1 .accent{color:var(--cyan)}
.underline-bar{
  width:64px;height:3px;
  background:linear-gradient(90deg,var(--cyan),transparent);
  border-radius:2px;margin-bottom:1.4rem;
  animation:fadeUp .7s .15s ease both;
}
.hero-desc{
  color:var(--muted);font-size:.96rem;line-height:1.8;
  margin-bottom:2.2rem;
  animation:fadeUp .7s .2s ease both;
}
.btn-group{display:flex;gap:1rem;flex-wrap:wrap;animation:fadeUp .7s .3s ease both}
.btn{
  padding:.65rem 1.55rem;
  border-radius:7px;
  font-size:.87rem;font-weight:500;
  cursor:pointer;text-decoration:none;
  transition:all .22s;
  display:inline-flex;align-items:center;gap:.45rem;
  letter-spacing:.2px;border:none;
  font-family:'Inter',sans-serif;
}
.btn-outline{
  background:transparent;
  border:1px solid rgba(255,255,255,0.2);
  color:var(--text);
}
.btn-outline:hover{border-color:var(--cyan);color:var(--cyan);background:rgba(0,212,200,0.05)}
.btn-cyan{
  background:var(--cyan);
  color:#070e1a;
  font-weight:600;
}
.btn-cyan:hover{background:var(--cyan2);transform:translateY(-1px)}

/* Avatar drop area */
.avatar-wrap{
  flex-shrink:0;
  position:relative;
}
.avatar-frame{
  width:270px;height:320px;
  border-radius:18px;
  border:1px solid var(--border2);
  background:linear-gradient(155deg,rgba(0,168,184,0.14) 0%,rgba(7,14,26,0.95) 100%);
  overflow:hidden;
  display:flex;align-items:flex-end;justify-content:center;
  position:relative;
}
.avatar-frame::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(circle at 50% 0%,rgba(0,212,200,0.18) 0%,transparent 65%);
}
.avatar-frame::after{
  content:'';
  position:absolute;bottom:0;left:0;right:0;height:80px;
  background:linear-gradient(transparent,rgba(7,14,26,0.6));
}
.avatar-svg{
  width:215px;position:relative;z-index:1;
  animation:dropIn 1.1s cubic-bezier(.36,.07,.19,.97) .15s both;
}
.avatar-svg.floating{animation:float 3.5s ease-in-out infinite}
.corner-accent{
  position:absolute;
  width:26px;height:26px;
  border-color:var(--cyan);
  border-style:solid;
  opacity:.5;
}
.ca-tl{top:10px;left:10px;border-width:2px 0 0 2px;border-radius:4px 0 0 0}
.ca-br{bottom:10px;right:10px;border-width:0 2px 2px 0;border-radius:0 0 4px 0}
.avatar-glow{
  position:absolute;
  bottom:-30px;left:50%;transform:translateX(-50%);
  width:140px;height:60px;
  background:radial-gradient(ellipse,rgba(0,212,200,0.25) 0%,transparent 70%);
  pointer-events:none;
}

/* scrolling hint */
.scroll-hint{
  position:absolute;bottom:2.5rem;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:6px;
  color:var(--muted2);font-size:.72rem;letter-spacing:1.5px;text-transform:uppercase;
  animation:fadeIn 1.5s 1.5s ease both;
}
.scroll-hint .arrow{
  width:20px;height:20px;
  border-right:1.5px solid var(--muted2);
  border-bottom:1.5px solid var(--muted2);
  transform:rotate(45deg);
  animation:float 1.3s ease-in-out infinite;
}

/* ===== ABOUT PAGE ===== */
#page-about{padding:6rem 4rem 4rem}
.page-inner{max-width:1100px;margin:0 auto}
.section-tag{font-size:.72rem;letter-spacing:2.5px;color:var(--cyan);text-transform:uppercase;margin-bottom:.5rem}
.section-title{font-family:'Syne',sans-serif;font-size:clamp(1.8rem,3vw,2.3rem);font-weight:800;margin-bottom:.6rem}
.section-div{width:44px;height:3px;background:var(--cyan);border-radius:2px;margin-bottom:3rem}

.about-grid{display:grid;grid-template-columns:1.1fr 0.9fr;gap:4rem;align-items:start;margin-bottom:4rem}
.about-text p{color:var(--muted);line-height:1.85;margin-bottom:1.1rem;font-size:.95rem}
.skill-section{margin-top:1.8rem}
.skill-label{font-size:.78rem;color:var(--cyan);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:.8rem;font-weight:600}
.skill-bar-group{display:flex;flex-direction:column;gap:.7rem}
.skill-bar-item{display:flex;flex-direction:column;gap:.3rem}
.skill-bar-top{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted)}
.skill-bar-bg{height:5px;background:rgba(255,255,255,0.06);border-radius:99px;overflow:hidden}
.skill-bar-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--cyan),var(--cyan2));transition:width 1.2s cubic-bezier(.4,0,.2,1)}
.skills-tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.4rem}
.skill-tag{
  padding:.3rem .85rem;border-radius:5px;
  background:rgba(0,212,200,0.08);
  border:1px solid rgba(0,212,200,0.2);
  color:var(--cyan);font-size:.77rem;font-weight:500;
}

.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.stat-card{
  background:var(--surface);border:1px solid var(--border);border-radius:12px;
  padding:1.4rem;text-align:center;
  transition:border-color .2s,transform .2s;
}
.stat-card:hover{border-color:var(--border2);transform:translateY(-2px)}
.stat-num{font-family:'Syne',sans-serif;font-size:2.2rem;font-weight:800;color:var(--cyan)}
.stat-label{font-size:.78rem;color:var(--muted);margin-top:.3rem}

.timeline{margin-top:1rem}
.tl-item{display:flex;gap:1.2rem;margin-bottom:1.8rem;position:relative}
.tl-item::before{
  content:'';position:absolute;left:7px;top:24px;bottom:-12px;
  width:1px;background:var(--border);
}
.tl-item:last-child::before{display:none}
.tl-dot{
  width:16px;height:16px;border-radius:50%;
  background:var(--surface2);border:2px solid var(--cyan);
  flex-shrink:0;margin-top:4px;
}
.tl-content{}
.tl-year{font-size:.72rem;color:var(--cyan);letter-spacing:1px;text-transform:uppercase;font-weight:600}
.tl-title{font-family:'Syne',sans-serif;font-weight:700;font-size:1rem;margin:.2rem 0}
.tl-sub{font-size:.83rem;color:var(--muted);line-height:1.6}

/* ===== PROJECTS PAGE ===== */
#page-projects{padding:6rem 4rem 4rem}
.projects-filter{display:flex;gap:.6rem;margin-bottom:2.5rem;flex-wrap:wrap}
.filter-btn{
  padding:.35rem .9rem;border-radius:99px;
  border:1px solid var(--border);
  background:transparent;color:var(--muted);
  font-size:.8rem;cursor:pointer;
  transition:all .2s;font-family:'Inter',sans-serif;
}
.filter-btn:hover,.filter-btn.active{
  border-color:var(--cyan);color:var(--cyan);
  background:rgba(0,212,200,0.07);
}
.projects-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:1.6rem}
.project-card{
  background:var(--surface);border:1px solid var(--border);border-radius:14px;
  padding:1.8rem;
  transition:border-color .25s,transform .25s,box-shadow .25s;
  cursor:default;position:relative;overflow:hidden;
}
.project-card::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(circle at 80% 20%,rgba(0,212,200,0.06),transparent 60%);
  opacity:0;transition:opacity .3s;
}
.project-card:hover{border-color:var(--border2);transform:translateY(-4px);box-shadow:0 12px 40px rgba(0,0,0,.3)}
.project-card:hover::before{opacity:1}
.project-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1rem}
.project-icon{font-size:1.6rem}
.project-links{display:flex;gap:.5rem}
.plink{
  width:30px;height:30px;border-radius:6px;
  background:rgba(255,255,255,0.05);border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  font-size:.8rem;cursor:pointer;transition:all .2s;
  color:var(--muted);text-decoration:none;
}
.plink:hover{border-color:var(--cyan);color:var(--cyan)}
.project-tag-badge{
  display:inline-block;
  font-size:.68rem;letter-spacing:1.5px;text-transform:uppercase;
  color:var(--cyan);background:rgba(0,212,200,0.1);
  border:1px solid rgba(0,212,200,0.2);
  border-radius:4px;padding:.18rem .55rem;
  margin-bottom:.7rem;
}
.project-name{font-family:'Syne',sans-serif;font-weight:800;font-size:1.15rem;margin-bottom:.5rem}
.project-desc{color:var(--muted);font-size:.85rem;line-height:1.7;margin-bottom:1.1rem}
.project-techs{display:flex;flex-wrap:wrap;gap:.4rem}
.tech{
  font-size:.72rem;padding:.22rem .6rem;border-radius:4px;
  background:rgba(255,255,255,0.04);color:var(--muted2);
  border:1px solid rgba(255,255,255,0.07);
}
.featured-badge{
  position:absolute;top:1rem;right:1rem;
  font-size:.65rem;padding:.18rem .55rem;border-radius:99px;
  background:rgba(0,212,200,0.15);color:var(--cyan);
  border:1px solid rgba(0,212,200,0.3);letter-spacing:.8px;text-transform:uppercase;
}

/* ===== SERVICES PAGE ===== */
#page-services{padding:6rem 4rem 4rem}
.services-hero{
  text-align:center;max-width:560px;margin:0 auto 3.5rem;
}
.services-hero p{color:var(--muted);font-size:.96rem;line-height:1.8}
.services-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:1.4rem;margin-bottom:4rem}
.service-card{
  background:var(--surface);border:1px solid var(--border);border-radius:13px;
  padding:1.6rem;transition:border-color .25s,transform .25s;
  position:relative;overflow:hidden;
}
.service-card:hover{border-color:var(--border2);transform:translateY(-3px)}
.service-card::after{
  content:'';position:absolute;bottom:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,var(--cyan),transparent);
  transform:scaleX(0);transform-origin:left;transition:transform .3s;
}
.service-card:hover::after{transform:scaleX(1)}
.service-icon-box{
  width:46px;height:46px;border-radius:10px;
  background:rgba(0,212,200,0.1);border:1px solid rgba(0,212,200,0.2);
  display:flex;align-items:center;justify-content:center;
  font-size:1.25rem;margin-bottom:1.1rem;
}
.service-name{font-family:'Syne',sans-serif;font-weight:700;font-size:1.02rem;margin-bottom:.55rem}
.service-desc{color:var(--muted);font-size:.83rem;line-height:1.7}
.service-more{
  margin-top:1rem;font-size:.78rem;color:var(--cyan);
  display:flex;align-items:center;gap:.3rem;cursor:pointer;
}

.process-section{margin-top:2rem}
.process-title{font-family:'Syne',sans-serif;font-size:1.4rem;font-weight:700;margin-bottom:2rem;text-align:center}
.process-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;position:relative}
.process-steps::before{
  content:'';position:absolute;top:24px;left:12%;right:12%;
  height:1px;background:linear-gradient(90deg,transparent,var(--border),var(--border),transparent);
}
.process-step{text-align:center;padding:1rem}
.step-num{
  width:48px;height:48px;border-radius:50%;
  border:1px solid var(--border2);
  background:var(--surface);
  display:flex;align-items:center;justify-content:center;
  font-family:'Syne',sans-serif;font-weight:800;font-size:1rem;
  color:var(--cyan);margin:0 auto 1rem;
  position:relative;z-index:1;
}
.step-label{font-weight:600;font-size:.88rem;margin-bottom:.4rem}
.step-sub{font-size:.78rem;color:var(--muted);line-height:1.6}

/* ===== CONTACT PAGE ===== */
#page-contact{padding:6rem 4rem 4rem}
.contact-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:4rem;align-items:start}
.contact-info{}
.contact-info p{color:var(--muted);font-size:.95rem;line-height:1.8;margin-bottom:2rem}
.contact-methods{display:flex;flex-direction:column;gap:1rem}
.contact-method{
  display:flex;align-items:center;gap:1rem;
  padding:1rem 1.2rem;
  background:var(--surface);border:1px solid var(--border);border-radius:10px;
  transition:border-color .2s;cursor:pointer;text-decoration:none;color:var(--text);
}
.contact-method:hover{border-color:var(--border2)}
.cm-icon{
  width:38px;height:38px;border-radius:8px;
  background:rgba(0,212,200,0.1);
  display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;
}
.cm-label{font-size:.78rem;color:var(--muted);margin-bottom:.1rem}
.cm-val{font-size:.9rem;font-weight:500}

.contact-form{
  background:var(--surface);border:1px solid var(--border);
  border-radius:16px;padding:2rem;
}
.form-title{font-family:'Syne',sans-serif;font-weight:700;font-size:1.2rem;margin-bottom:1.6rem}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.form-group{margin-bottom:1rem}
.form-group label{display:block;font-size:.78rem;color:var(--muted);margin-bottom:.45rem;letter-spacing:.3px}
.form-group input,
.form-group textarea,
.form-group select{
  width:100%;
  background:rgba(255,255,255,0.04);
  border:1px solid var(--border);
  border-radius:8px;
  padding:.65rem .9rem;
  color:var(--text);
  font-family:'Inter',sans-serif;
  font-size:.88rem;
  outline:none;
  transition:border-color .2s,background .2s;
  resize:none;
}
.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus{
  border-color:var(--cyan);
  background:rgba(0,212,200,0.04);
}
.form-group textarea{height:120px}
.form-group select option{background:#0f1e30}
.btn-submit{
  width:100%;padding:.75rem;border-radius:8px;
  background:var(--cyan);color:#070e1a;
  font-family:'Syne',sans-serif;font-weight:700;font-size:.95rem;
  border:none;cursor:pointer;transition:all .22s;
  margin-top:.5rem;
}
.btn-submit:hover{background:var(--cyan2);transform:translateY(-1px)}

.social-strip{display:flex;gap:.8rem;margin-top:1.8rem}
.social-btn{
  width:40px;height:40px;border-radius:8px;
  border:1px solid var(--border);
  background:transparent;
  display:flex;align-items:center;justify-content:center;
  font-size:1.1rem;cursor:pointer;transition:all .2s;
  color:var(--muted);text-decoration:none;
}
.social-btn:hover{border-color:var(--cyan);color:var(--cyan);transform:translateY(-2px)}

/* ===== FOOTER ===== */
footer{
  text-align:center;padding:2rem;
  border-top:1px solid var(--border);
  color:var(--muted2);font-size:.78rem;
  position:relative;z-index:1;
}

/* ===== PAGE TRANSITION ===== */
.page{opacity:0;transform:translateY(10px);transition:opacity .35s ease,transform .35s ease}
.page.active{display:block;opacity:1;transform:translateY(0)}

/* ===== TOAST ===== */
.toast{
  position:fixed;bottom:2rem;left:50%;transform:translateX(-50%) translateY(20px);
  background:var(--surface2);border:1px solid var(--border2);
  color:var(--text);padding:.65rem 1.4rem;border-radius:8px;
  font-size:.85rem;opacity:0;transition:all .3s;pointer-events:none;z-index:999;
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

@media(max-width:860px){
  nav{padding:1rem 1.5rem}
  #page-home{padding:74px 1.5rem 3rem}
  .hero-inner{flex-direction:column-reverse;text-align:center;padding-top:2rem}
  .underline-bar{margin:0 auto 1.4rem}
  .btn-group{justify-content:center}
  .avatar-frame{width:220px;height:260px}
  .avatar-svg{width:175px}
  section[id^="page-"]{padding:5rem 1.5rem 3rem}
  .about-grid,.contact-grid{grid-template-columns:1fr}
  .process-steps{grid-template-columns:1fr 1fr}
  .form-row{grid-template-columns:1fr}
}
</style>
</head>
<body>

<div class="bg-layer"></div>
<div class="bg-grid"></div>

<!-- NAV -->
<nav>
  <div class="logo" onclick="navigate('home')"><span>A</span>mine</div>
  <ul class="nav-links">
