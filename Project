<script>
// ===== NAVIGATION =====
let currentPage = 'home';
let avatarFloating = false;

function navigate(page) {
  // Hide current
  const cur = document.getElementById('page-' + currentPage);
  cur.style.opacity = '0';
  cur.style.transform = 'translateY(10px)';
  setTimeout(() => {
    cur.classList.remove('active');
    cur.style.display = 'none';

    // Show next
    const next = document.getElementById('page-' + page);
    next.style.display = 'block';
    next.style.opacity = '0';
    next.style.transform = 'translateY(10px)';

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        next.style.opacity = '1';
        next.style.transform = 'translateY(0)';
        next.classList.add('active');
      });
    });

    currentPage = page;

    // Update nav active state
    document.querySelectorAll('.nav-links a').forEach(a => {
      a.classList.toggle('active', a.dataset.page === page);
    });

    // Animate skill bars if about
    if (page === 'about') {
      setTimeout(animateSkillBars, 200);
    }

    window.scrollTo({top:0, behavior:'smooth'});
  }, 220);
}

// ===== AVATAR DROP ON LOAD =====
window.addEventListener('load', () => {
  const svg = document.getElementById('avatar-svg');
  // Reset and play drop animation
  svg.style.animation = 'none';
  svg.offsetHeight; // reflow
  svg.style.animation = 'dropIn 1.15s cubic-bezier(.36,.07,.19,.97) .2s both';

  // After drop completes, start floating
  setTimeout(() => {
    svg.style.animation = 'float 3.6s ease-in-out infinite';
    avatarFloating = true;
  }, 1500);
});

// ===== SKILL BARS =====
function animateSkillBars() {
  document.querySelectorAll('.skill-bar-fill').forEach(bar => {
    bar.style.width = '0%';
    setTimeout(() => {
      bar.style.width = bar.dataset.width;
    }, 50);
  });
}

// ===== PROJECT FILTER =====
document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const filter = btn.dataset.filter;
    document.querySelectorAll('.project-card').forEach(card => {
      const show = filter === 'all' || card.dataset.cat === filter;
      card.style.opacity = show ? '1' : '0.2';
      card.style.transform = show ? 'scale(1)' : 'scale(0.96)';
      card.style.transition = 'opacity .3s, transform .3s';
      card.style.pointerEvents = show ? 'auto' : 'none';
    });
  });
});

// ===== CONTACT FORM =====
function sendMessage() {
  const toast = document.getElementById('toast');
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 3500);
}

// ===== RE-TRIGGER AVATAR DROP ON HOME NAV =====
document.querySelectorAll('.nav-links a').forEach(a => {
  if (a.dataset.page === 'home') {
    a.addEventListener('click', () => {
      setTimeout(() => {
        const svg = document.getElementById('avatar-svg');
        svg.style.animation = 'none';
        svg.offsetHeight;
        svg.style.animation = 'dropIn 1.15s cubic-bezier(.36,.07,.19,.97) 0s both';
        setTimeout(() => {
          svg.style.animation = 'float 3.6s ease-in-out infinite';
        }, 1350);
      }, 300);
    });
  }
});
